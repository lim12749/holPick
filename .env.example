# =============================================================
# holPick — 환경 변수 템플릿
# 이 파일을 `.env.local` 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
# 실제 값이 담긴 .env.local 은 커밋되지 않습니다.
# =============================================================


# -------------------------------------------------------------
# 공공데이터포털 인증
# -------------------------------------------------------------
# https://www.data.go.kr 에서 아래 데이터셋들을 활용신청(개발단계 자동승인)한 뒤,
# 마이페이지 → 데이터활용 → Open API → 개발계정 에서 인증키를 확인합니다.
# fetch + URLSearchParams 로 호출하므로 반드시 "Decoding" 키를 사용하세요.
KRA_API_KEY=

# 한국마사회 서비스 공통 base URL (기관코드 B551015)
KRA_API_BASE_URL=https://apis.data.go.kr/B551015


# -------------------------------------------------------------
# 데이터셋 경로 — base URL 뒤에 붙는 {API번호}/{오퍼레이션명}
# -------------------------------------------------------------
# 오퍼레이션명은 마이페이지 → 개발계정 → 해당 API → 상세기능 의
# "요청주소" 맨 뒤 조각에서 확인합니다.

# 경주마 상세정보 (data.go.kr/data/15058115)
KRA_EP_HORSE_DETAIL=API8_2/raceHorseInfo_2

# 출전표 상세정보 (data.go.kr/data/15058677)
# API 번호는 API26_2 로 확인됨. 오퍼레이션명을 붙여 API26_2/<오퍼레이션명> 형태로 채우세요.
KRA_EP_ENTRY_LIST=

# 경주기록 정보 (data.go.kr/data/15058305)
# API 번호는 API4_3 으로 확인됨.
KRA_EP_RACE_RESULT=

# 경주마 성적 정보 (data.go.kr/data/15058779)
KRA_EP_HORSE_RECORD=

# 경주마 레이팅 정보 (data.go.kr/data/15057323)
# API 번호는 API77 로 확인됨.
KRA_EP_HORSE_RATING=

# 기수 성적 정보 (data.go.kr/data/15056591)
KRA_EP_JOCKEY_RECORD=

# 마필 구간별 경주기록 (data.go.kr/data/15057859)
# API 번호는 API37 로 확인됨.
KRA_EP_SECTIONAL_RECORD=

# 경주마 출전취소 정보 (data.go.kr/data/15056779)
KRA_EP_ENTRY_CANCEL=


# -------------------------------------------------------------
# AI 학습용 데이터 (별도 취급)
# -------------------------------------------------------------
# AI학습용 경주계획 (data.go.kr/data/15143802)
# 경주 단위 조건 데이터: 거리, 두수, 등급, 출전조건, 1~5착 상금,
# 날씨, 주로상태, 발주예정·실제시각.
#
# ※ meet 코드가 다른 API와 순서가 다릅니다.
#    AI학습용 경주계획 → 1=서울, 2=제주, 3=부산경남
#    일반 API 다수      → 1=서울, 2=부산경남, 3=제주
KRA_AI_BASE_URL=https://apis.data.go.kr/B551015
KRA_EP_AI_RACE_PLAN=


# -------------------------------------------------------------
# 호출 기본값
# -------------------------------------------------------------
KRA_DEFAULT_MEET=1
KRA_RESPONSE_TYPE=json
KRA_NUM_OF_ROWS=100
KRA_TIMEOUT_MS=10000

# 일일 호출 한도 (마이페이지 개발계정 화면에서 확인)
KRA_DAILY_QUOTA=


# -------------------------------------------------------------
# 데이터베이스 (적재 계층 구축 시 사용 — 아직 미구성)
# -------------------------------------------------------------
# DATABASE_URL=
